{
  "name": "aetheria",
  "version": "0.1.0",
  "description": "Aetheria - a multiplayer voxel survival sandbox",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/main.ts",
    "server:watch": "tsx watch server/main.ts",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0"
  },
  "license": "MIT",
  "dependencies": {
    "three": "^0.182.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24",
    "@types/three": "^0.182.0",
    "@types/ws": "^8.18.0",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vite": "^7",
    "vitest": "^3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
